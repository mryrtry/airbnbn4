{
  "id": "confirm-delete",
  "schemaVersion": 16,
  "components": [
    {
      "type": "text",
      "label": "Подтверждение удаления",
      "id": "InfoHeader",
      "text": "Вы уверены, что хотите удалить это объявление? Действие необратимо."
    },
    {
      "type": "textfield",
      "label": "ID объявления",
      "id": "InfoListingId",
      "key": "formListingId",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Название",
      "id": "InfoListingTitle",
      "key": "formListingTitle",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Адрес",
      "id": "InfoListingAddress",
      "key": "formListingAddress",
      "readonly": true
    },
    {
      "type": "number",
      "label": "Цена",
      "id": "InfoListingPrice",
      "key": "formListingPrice",
      "readonly": true
    },
    {
      "type": "checkbox",
      "label": "Подтверждаю удаление",
      "id": "Field_confirm",
      "key": "confirmDelete"
    }
  ],
  "type": "default"
}