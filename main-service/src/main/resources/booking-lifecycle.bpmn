<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Defs_BookingLifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collab_Booking">
    <bpmn:participant id="Participant_Platform" name="Airbnb BPM" processRef="booking-lifecycle" />
    <bpmn:participant id="Participant_Bitrix" name="Bitrix24" />
    <bpmn:participant id="Participant_Notif" name="Notification Service" />
    <bpmn:messageFlow id="MF_Bitrix_Create" sourceRef="Task_CreateBooking" targetRef="Participant_Bitrix" />
    <bpmn:messageFlow id="MF_Bitrix_Confirm" sourceRef="Task_ConfirmBooking" targetRef="Participant_Bitrix" />
    <bpmn:messageFlow id="MF_Bitrix_Reject" sourceRef="Task_RejectBooking" targetRef="Participant_Bitrix" />
    <bpmn:messageFlow id="MF_Bitrix_CheckIn" sourceRef="Task_RegisterCheckIn" targetRef="Participant_Bitrix" />
    <bpmn:messageFlow id="MF_Bitrix_CheckOut" sourceRef="Task_RegisterCheckOut" targetRef="Participant_Bitrix" />
    <bpmn:messageFlow id="MF_Notif_BusinessError" sourceRef="Task_SendBusinessError" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_Owner" sourceRef="Task_SendNotifyOwner" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_Rejected" sourceRef="Task_SendNotifyRejected" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_Approved" sourceRef="Task_SendNotifyApproved" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_CheckInGuest" sourceRef="Task_SendNotifyCheckInGuest" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_CheckInOwner" sourceRef="Task_SendNotifyCheckInOwner" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_CheckOutGuest" sourceRef="Task_SendNotifyCheckOutGuest" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_CheckOutOwner" sourceRef="Task_SendNotifyCheckOutOwner" targetRef="Participant_Notif" />
  </bpmn:collaboration>
  <bpmn:process id="booking-lifecycle" name="Букинг" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Booking">
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_InitContext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ListingProvided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBookingForm_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBusinessError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBusinessError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Booking_BusinessError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBookingForm_Owner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBookingForm_CheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterCheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyCheckInGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyCheckInGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyCheckInOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyCheckInOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBookingForm_CheckOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterCheckOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyCheckOutGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyCheckOutGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyCheckOutOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyCheckOutOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="Владелец">
        <bpmn:flowNodeRef>Task_OwnerDecide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guest" name="Гость">
        <bpmn:flowNodeRef>Task_SelectListingDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckOut</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_OwnerDecide" name="Решение владельца" camunda:candidateUsers="${ownerId}" camunda:formRef="owner-decide" camunda:formRefBinding="latest">
      <bpmn:incoming>F5b</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_InitContext" name="Инициализация контекста пользователя" camunda:delegateExpression="${initUserContextDelegate}">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_ListingProvided" name="ID объявления задан?" default="F_AskListing">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F_ListingProvided</bpmn:outgoing>
      <bpmn:outgoing>F_AskListing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PrepareBookingForm_Select" name="Подготовка формы бронирования (выбор)" camunda:delegateExpression="${prepareBookingFormDelegate}">
      <bpmn:incoming>F_AskListing</bpmn:incoming>
      <bpmn:outgoing>F_PrepareSelect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckAvailable" name="Проверка доступности объявления" camunda:delegateExpression="${checkBookingAvailableDelegate}">
      <bpmn:incoming>F_ListingProvided</bpmn:incoming>
      <bpmn:incoming>F_AfterSelect</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_CheckAvailable" name="Проверка пройдена?" default="F_CheckOk">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_CheckOk</bpmn:outgoing>
      <bpmn:outgoing>F_NotFound</bpmn:outgoing>
      <bpmn:outgoing>F_NotAvailable</bpmn:outgoing>
      <bpmn:outgoing>F_OwnListing</bpmn:outgoing>
      <bpmn:outgoing>F_HasActive</bpmn:outgoing>
      <bpmn:outgoing>F_NoDates</bpmn:outgoing>
      <bpmn:outgoing>F_InvalidDates</bpmn:outgoing>
      <bpmn:outgoing>F_DateInPast</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PrepareBusinessError" name="Подготовка уведомления об ошибке" camunda:delegateExpression="${prepareBusinessErrorNotificationDelegate}">
      <bpmn:incoming>F_NotFound</bpmn:incoming>
      <bpmn:incoming>F_NotAvailable</bpmn:incoming>
      <bpmn:incoming>F_OwnListing</bpmn:incoming>
      <bpmn:incoming>F_HasActive</bpmn:incoming>
      <bpmn:incoming>F_NoDates</bpmn:incoming>
      <bpmn:incoming>F_InvalidDates</bpmn:incoming>
      <bpmn:incoming>F_DateInPast</bpmn:incoming>
      <bpmn:outgoing>F_BusinessErrorPrepared</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendBusinessError" name="Отправка уведомления об ошибке" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F_BusinessErrorPrepared</bpmn:incoming>
      <bpmn:outgoing>F_BusinessErrorSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Booking_BusinessError" name="Ошибка данных">
      <bpmn:incoming>F_BusinessErrorSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateBooking" name="Создание брони" camunda:delegateExpression="${createBookingDelegate}">
      <bpmn:incoming>F_CheckOk</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyOwner" name="Подготовка уведомления владельцу" camunda:delegateExpression="${prepareBookingNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">BOOKING_CREATED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyOwner" name="Отправка уведомления владельцу" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareBookingForm_Owner" name="Подготовка формы бронирования (владелец)" camunda:delegateExpression="${prepareBookingFormDelegate}">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F5b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Решение?" default="F_Reject">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F_Approve</bpmn:outgoing>
      <bpmn:outgoing>F_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RejectBooking" name="Отклонение брони" camunda:delegateExpression="${rejectBookingDelegate}">
      <bpmn:incoming>F_Reject</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyRejected" name="Подготовка уведомления об отклонении" camunda:delegateExpression="${prepareBookingNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">BOOKING_REJECTED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyRejected" name="Отправка уведомления об отклонении" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Отклонено">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ConfirmBooking" name="Подтверждение брони" camunda:delegateExpression="${confirmBookingDelegate}">
      <bpmn:incoming>F_Approve</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyApproved" name="Подготовка уведомления об одобрении" camunda:delegateExpression="${prepareBookingNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">BOOKING_APPROVED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyApproved" name="Отправка уведомления об одобрении" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareBookingForm_CheckIn" name="Подготовка формы бронирования (заезд)" camunda:delegateExpression="${prepareBookingFormDelegate}">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F13b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RegisterCheckIn" name="Регистрация заезда" camunda:delegateExpression="${checkInDelegate}">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyCheckInGuest" name="Подготовка уведомления о заезде (гость)" camunda:delegateExpression="${prepareBookingNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">BOOKING_CHECKED_IN</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F15a</bpmn:incoming>
      <bpmn:outgoing>F15b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyCheckInGuest" name="Отправка уведомления о заезде (гость)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F15b</bpmn:incoming>
      <bpmn:outgoing>F15c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyCheckInOwner" name="Подготовка уведомления о заезде (владелец)" camunda:delegateExpression="${prepareBookingNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">BOOKING_CHECKED_IN</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F15c</bpmn:incoming>
      <bpmn:outgoing>F15d</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyCheckInOwner" name="Отправка уведомления о заезде (владелец)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F15d</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareBookingForm_CheckOut" name="Подготовка формы бронирования (выезд)" camunda:delegateExpression="${prepareBookingFormDelegate}">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F16b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RegisterCheckOut" name="Регистрация выезда" camunda:delegateExpression="${checkOutDelegate}">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F17a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StartResolution" name="Запуск процесса разрешения споров" camunda:delegateExpression="${startResolutionDelegate}">
      <bpmn:incoming>F17a</bpmn:incoming>
      <bpmn:outgoing>F18a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyCheckOutGuest" name="Подготовка уведомления о выезде (гость)" camunda:delegateExpression="${prepareBookingNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">BOOKING_CHECKED_OUT</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F18a</bpmn:incoming>
      <bpmn:outgoing>F18b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyCheckOutGuest" name="Отправка уведомления о выезде (гость)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F18b</bpmn:incoming>
      <bpmn:outgoing>F18c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyCheckOutOwner" name="Подготовка уведомления о выезде (владелец)" camunda:delegateExpression="${prepareBookingNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">BOOKING_CHECKED_OUT</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>F18c</bpmn:incoming>
      <bpmn:outgoing>F18d</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyCheckOutOwner" name="Отправка уведомления о выезде (владелец)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F18d</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Completed" name="Завершено">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_SelectListingDates" name="Выбор объявления и дат" camunda:candidateUsers="${initiatorUserId}" camunda:formRef="create-booking" camunda:formRefBinding="latest">
      <bpmn:incoming>F_PrepareSelect</bpmn:incoming>
      <bpmn:outgoing>F_AfterSelect</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Booking" name="Старт">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CheckIn" name="Подтверждение заезда" camunda:candidateUsers="${guestId}" camunda:formRef="check-in" camunda:formRefBinding="latest">
      <bpmn:incoming>F13b</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckOut" name="Подтверждение выезда" camunda:candidateUsers="${guestId}" camunda:formRef="check-out" camunda:formRefBinding="latest">
      <bpmn:incoming>F16b</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F5b" sourceRef="Task_PrepareBookingForm_Owner" targetRef="Task_OwnerDecide" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_OwnerDecide" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F0" sourceRef="Start_Booking" targetRef="Task_InitContext" />
    <bpmn:sequenceFlow id="F1" sourceRef="Task_InitContext" targetRef="Gw_ListingProvided" />
    <bpmn:sequenceFlow id="F_ListingProvided" name="Да" sourceRef="Gw_ListingProvided" targetRef="Task_CheckAvailable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('listingId') &amp;&amp; listingId != null}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_AskListing" name="Нет" sourceRef="Gw_ListingProvided" targetRef="Task_PrepareBookingForm_Select" />
    <bpmn:sequenceFlow id="F_PrepareSelect" sourceRef="Task_PrepareBookingForm_Select" targetRef="Task_SelectListingDates" />
    <bpmn:sequenceFlow id="F_AfterSelect" sourceRef="Task_SelectListingDates" targetRef="Task_CheckAvailable" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckAvailable" targetRef="Gw_CheckAvailable" />
    <bpmn:sequenceFlow id="F_NotFound" name="Не найдено" sourceRef="Gw_CheckAvailable" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_FOUND'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NotAvailable" name="Недоступно" sourceRef="Gw_CheckAvailable" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_AVAILABLE'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_OwnListing" name="Своё объявление" sourceRef="Gw_CheckAvailable" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'OWN_LISTING'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_HasActive" name="Есть активная бронь" sourceRef="Gw_CheckAvailable" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'HAS_ACTIVE'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NoDates" name="Нет дат" sourceRef="Gw_CheckAvailable" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'NO_DATES'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_InvalidDates" name="Неверные даты" sourceRef="Gw_CheckAvailable" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'INVALID_DATES'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_DateInPast" name="Дата в прошлом" sourceRef="Gw_CheckAvailable" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'DATE_IN_PAST'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CheckOk" name="Да" sourceRef="Gw_CheckAvailable" targetRef="Task_CreateBooking" />
    <bpmn:sequenceFlow id="F_BusinessErrorPrepared" sourceRef="Task_PrepareBusinessError" targetRef="Task_SendBusinessError" />
    <bpmn:sequenceFlow id="F_BusinessErrorSent" sourceRef="Task_SendBusinessError" targetRef="End_Booking_BusinessError" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_CreateBooking" targetRef="Task_PrepareNotifyOwner" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_PrepareNotifyOwner" targetRef="Task_SendNotifyOwner" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_SendNotifyOwner" targetRef="Task_PrepareBookingForm_Owner" />
    <bpmn:sequenceFlow id="F_Approve" name="Одобрено" sourceRef="Gw_Decision" targetRef="Task_ConfirmBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${ownerDecision == 'APPROVE'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Reject" name="Отклонено" sourceRef="Gw_Decision" targetRef="Task_RejectBooking" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_RejectBooking" targetRef="Task_PrepareNotifyRejected" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_PrepareNotifyRejected" targetRef="Task_SendNotifyRejected" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_SendNotifyRejected" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_ConfirmBooking" targetRef="Task_PrepareNotifyApproved" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_PrepareNotifyApproved" targetRef="Task_SendNotifyApproved" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_SendNotifyApproved" targetRef="Task_PrepareBookingForm_CheckIn" />
    <bpmn:sequenceFlow id="F13b" sourceRef="Task_PrepareBookingForm_CheckIn" targetRef="Task_CheckIn" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_CheckIn" targetRef="Task_RegisterCheckIn" />
    <bpmn:sequenceFlow id="F15a" sourceRef="Task_RegisterCheckIn" targetRef="Task_PrepareNotifyCheckInGuest" />
    <bpmn:sequenceFlow id="F15b" sourceRef="Task_PrepareNotifyCheckInGuest" targetRef="Task_SendNotifyCheckInGuest" />
    <bpmn:sequenceFlow id="F15c" sourceRef="Task_SendNotifyCheckInGuest" targetRef="Task_PrepareNotifyCheckInOwner" />
    <bpmn:sequenceFlow id="F15d" sourceRef="Task_PrepareNotifyCheckInOwner" targetRef="Task_SendNotifyCheckInOwner" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_SendNotifyCheckInOwner" targetRef="Task_PrepareBookingForm_CheckOut" />
    <bpmn:sequenceFlow id="F16b" sourceRef="Task_PrepareBookingForm_CheckOut" targetRef="Task_CheckOut" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_CheckOut" targetRef="Task_RegisterCheckOut" />
    <bpmn:sequenceFlow id="F17a" sourceRef="Task_RegisterCheckOut" targetRef="Task_StartResolution" />
    <bpmn:sequenceFlow id="F18a" sourceRef="Task_StartResolution" targetRef="Task_PrepareNotifyCheckOutGuest" />
    <bpmn:sequenceFlow id="F18b" sourceRef="Task_PrepareNotifyCheckOutGuest" targetRef="Task_SendNotifyCheckOutGuest" />
    <bpmn:sequenceFlow id="F18c" sourceRef="Task_SendNotifyCheckOutGuest" targetRef="Task_PrepareNotifyCheckOutOwner" />
    <bpmn:sequenceFlow id="F18d" sourceRef="Task_PrepareNotifyCheckOutOwner" targetRef="Task_SendNotifyCheckOutOwner" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_SendNotifyCheckOutOwner" targetRef="End_Completed" />
  </bpmn:process>
