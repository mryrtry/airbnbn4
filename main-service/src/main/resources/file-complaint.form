{
  "id": "file-complaint",
  "schemaVersion": 16,
  "components": [
    {
      "type": "text",
      "label": "Подача жалобы",
      "id": "InfoHeader",
      "text": "Опишите причину жалобы по бронированию. Окно подачи ограничено по времени."
    },
    {
      "type": "textfield",
      "label": "Номер брони",
      "id": "InfoBookingId",
      "key": "formBookingId",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Объявление",
      "id": "InfoListingTitle",
      "key": "formListingTitle",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Гость",
      "id": "InfoGuestId",
      "key": "formGuestId",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Даты",
      "id": "InfoDates",
      "key": "formBookingDates",
      "readonly": true
    },
    {
      "type": "textarea",
      "label": "Причина жалобы",
      "id": "Field_reason",
      "key": "reason",
      "validate": { "required": true, "minLength": 5, "maxLength": 2000 }
    },
    {
      "type": "textarea",
      "label": "Комментарий",
      "id": "Field_comment",
      "key": "ownerComment",
      "validate": { "maxLength": 1000 }
    }
  ],
  "type": "default"
}