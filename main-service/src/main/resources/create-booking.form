{
  "id": "create-booking",
  "schemaVersion": 16,
  "components": [
    {
      "type": "text",
      "label": "Информация",
      "id": "InfoHeader",
      "text": "Выберите объявление и укажите даты бронирования. Даты — в формате YYYY-MM-DD."
    },
    {
      "type": "textarea",
      "label": "Доступные объявления",
      "id": "InfoAvailableListings",
      "key": "formAvailableListings",
      "readonly": true,
      "layout": { "row": "Row_Info1", "columns": null }
    },
    {
      "type": "number",
      "label": "ID объявления",
      "id": "Field_listingId",
      "key": "listingId",
      "validate": { "required": true, "min": 1, "max": 999999 }
    },
    {
      "type": "textfield",
      "label": "Дата заезда (YYYY-MM-DD)",
      "id": "Field_start",
      "key": "bookingStart",
      "validate": {
        "required": false,
        "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
      }
    },
    {
      "type": "textfield",
      "label": "Дата выезда (YYYY-MM-DD)",
      "id": "Field_end",
      "key": "bookingEnd",
      "validate": {
        "required": false,
        "pattern": "^(19|20)\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
      }
    }
  ],
  "type": "default"
}