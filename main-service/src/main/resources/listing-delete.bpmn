<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Defs_ListingDelete"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="listing-delete" name="Удалить листинг" isExecutable="true"
                camunda:historyTimeToLive="180">

    <bpmn:startEvent id="Start_Delete" name="Start">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="F0" sourceRef="Start_Delete" targetRef="Task_InitContext" />

    <bpmn:serviceTask id="Task_InitContext" name="Init user context"
                      camunda:delegateExpression="${initUserContextDelegate}">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F1" sourceRef="Task_InitContext" targetRef="Task_CheckOwnerAvailableListings" />

    <bpmn:serviceTask id="Task_CheckOwnerAvailableListings" name="Проверка доступных объявлений"
                      camunda:delegateExpression="${checkOwnerAvailableListingsDelegate}">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F1_CheckAvailable</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F1_CheckAvailable" sourceRef="Task_CheckOwnerAvailableListings"
                       targetRef="Gw_HasAvailableListings" />

    <bpmn:exclusiveGateway id="Gw_HasAvailableListings" name="Есть доступные объявления?"
                           default="F_NoAvailableListings">
      <bpmn:incoming>F1_CheckAvailable</bpmn:incoming>
      <bpmn:outgoing>F_HasAvailableListings</bpmn:outgoing>
      <bpmn:outgoing>F_NoAvailableListings</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="F_HasAvailableListings" name="Да"
                       sourceRef="Gw_HasAvailableListings" targetRef="Gw_ListingIdProvided">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${hasAvailableListings}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F_NoAvailableListings" name="Нет"
                       sourceRef="Gw_HasAvailableListings" targetRef="Task_PrepareBusinessError" />

    <bpmn:exclusiveGateway id="Gw_ListingIdProvided" name="listingId задан?" default="F_AskListing">
      <bpmn:incoming>F_HasAvailableListings</bpmn:incoming>
      <bpmn:outgoing>F_ListingIdProvided</bpmn:outgoing>
      <bpmn:outgoing>F_AskListing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="F_ListingIdProvided" name="Да"
                       sourceRef="Gw_ListingIdProvided" targetRef="Task_CheckOwnership">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('listingId') &amp;&amp; listingId != null}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F_AskListing" name="Нет"
                       sourceRef="Gw_ListingIdProvided" targetRef="Task_PrepareListingForm_Select" />

    <bpmn:serviceTask id="Task_PrepareListingForm_Select" name="Prepare listing form (select)"
                      camunda:delegateExpression="${prepareListingFormDelegate}">
      <bpmn:incoming>F_AskListing</bpmn:incoming>
      <bpmn:outgoing>F_AskListing_b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F_AskListing_b" sourceRef="Task_PrepareListingForm_Select"
                       targetRef="Task_SelectListing" />

    <bpmn:userTask id="Task_SelectListing" name="Выбор объявления"
                   camunda:candidateGroups="OWNER"
                   camunda:formRef="select-listing"
                   camunda:formRefBinding="latest">
      <bpmn:incoming>F_AskListing_b</bpmn:incoming>
      <bpmn:outgoing>F2_AfterSelect</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="F2_AfterSelect" sourceRef="Task_SelectListing"
                       targetRef="Task_CheckOwnership" />

    <bpmn:serviceTask id="Task_CheckOwnership" name="Check ownership"
                      camunda:delegateExpression="${checkListingOwnershipDelegate}">
      <bpmn:incoming>F_ListingIdProvided</bpmn:incoming>
      <bpmn:incoming>F2_AfterSelect</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckOwnership" targetRef="Gw_CheckResult" />

    <bpmn:exclusiveGateway id="Gw_CheckResult" name="Check OK?" default="F_CheckOk">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_CheckOk</bpmn:outgoing>
      <bpmn:outgoing>F_NotFound</bpmn:outgoing>
      <bpmn:outgoing>F_NotOwner</bpmn:outgoing>
      <bpmn:outgoing>F_NotAvailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="F_NotFound" sourceRef="Gw_CheckResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_FOUND'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F_NotOwner" sourceRef="Gw_CheckResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_OWNER'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F_NotAvailable" sourceRef="Gw_CheckResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_AVAILABLE'}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F_CheckOk" sourceRef="Gw_CheckResult" targetRef="Task_PrepareListingForm_Confirm" />

    <bpmn:serviceTask id="Task_PrepareListingForm_Confirm" name="Prepare listing form (confirm)"
                      camunda:delegateExpression="${prepareListingFormDelegate}">
      <bpmn:incoming>F_CheckOk</bpmn:incoming>
      <bpmn:outgoing>F_CheckOk_b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F_CheckOk_b" sourceRef="Task_PrepareListingForm_Confirm"
                       targetRef="Task_ConfirmDelete" />

    <bpmn:userTask id="Task_ConfirmDelete" name="Подтверждение удаления"
                   camunda:candidateUsers="${initiatorUserId}"
                   camunda:formRef="confirm-delete"
                   camunda:formRefBinding="latest">
      <bpmn:incoming>F_CheckOk_b</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="F3" sourceRef="Task_ConfirmDelete" targetRef="Task_DeleteListing" />

    <bpmn:serviceTask id="Task_DeleteListing" name="Soft-delete listing"
                      camunda:delegateExpression="${deleteListingDelegate}">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F4" sourceRef="Task_DeleteListing" targetRef="Gw_DeleteResult" />

    <bpmn:exclusiveGateway id="Gw_DeleteResult" name="Delete OK?" default="F_DeleteOk">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F_DeleteOk</bpmn:outgoing>
      <bpmn:outgoing>F_DeleteFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="F_DeleteFail" sourceRef="Gw_DeleteResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        ${execution.hasVariable('deleteError') &amp;&amp; deleteError != null}
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="F_DeleteOk" sourceRef="Gw_DeleteResult" targetRef="End_Deleted" />

    <bpmn:endEvent id="End_Deleted" name="Deleted">
      <bpmn:incoming>F_DeleteOk</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_PrepareBusinessError" name="Подготовка уведомления об ошибке"
                      camunda:delegateExpression="${prepareBusinessErrorNotificationDelegate}">
      <bpmn:incoming>F_NoAvailableListings</bpmn:incoming>
      <bpmn:incoming>F_NotFound</bpmn:incoming>
      <bpmn:incoming>F_NotOwner</bpmn:incoming>
      <bpmn:incoming>F_NotAvailable</bpmn:incoming>
      <bpmn:incoming>F_DeleteFail</bpmn:incoming>
      <bpmn:outgoing>F_BusinessErrorPrepared</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F_BusinessErrorPrepared" sourceRef="Task_PrepareBusinessError"
                       targetRef="Task_SendBusinessError" />

    <bpmn:serviceTask id="Task_SendBusinessError" name="Отправка уведомления об ошибке"
                      camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F_BusinessErrorPrepared</bpmn:incoming>
      <bpmn:outgoing>F_BusinessErrorSent</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="F_BusinessErrorSent" sourceRef="Task_SendBusinessError"
                       targetRef="End_Delete_BusinessError" />

    <bpmn:endEvent id="End_Delete_BusinessError" name="Ошибка данных">
      <bpmn:incoming>F_BusinessErrorSent</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>
