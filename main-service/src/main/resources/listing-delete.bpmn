<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Defs_ListingDelete" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_0hr26ek">
    <bpmn:participant id="Participant_0sjzgf6" name="Airbnb" processRef="listing-delete" />
    <bpmn:participant id="Participant_Bitrix" name="Bitrix24" />
    <bpmn:participant id="Participant_Notif" name="Notification Service" />
    <bpmn:messageFlow id="MF_Bitrix_DeleteListing" sourceRef="Task_DeleteListing" targetRef="Participant_Bitrix" />
    <bpmn:messageFlow id="MF_Notif_BusinessError" sourceRef="Task_SendBusinessError" targetRef="Participant_Notif" />
    <bpmn:messageFlow id="MF_Notif_DeleteCancelled" sourceRef="Task_SendCancelledNotify" targetRef="Participant_Notif" />
  </bpmn:collaboration>
  <bpmn:process id="listing-delete" name="Удалить листинг" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_ListingDelete">
      <bpmn:lane id="Lane_Owner" name="Владелец">
        <bpmn:flowNodeRef>Task_SelectListing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmDelete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Delete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_InitContext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckOwnerAvailableListings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_HasAvailableListings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ListingIdProvided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareListingForm_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckOwnership</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareListingForm_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ConfirmDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeleteListing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DeleteResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Deleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBusinessError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBusinessError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delete_BusinessError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DeleteCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareCancelledNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCancelledNotify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Task_SelectListing" name="Выбор объявления" camunda:candidateGroups="OWNER" camunda:formRef="select-listing" camunda:formRefBinding="latest">
      <bpmn:incoming>F_AskListing_b</bpmn:incoming>
      <bpmn:outgoing>F2_AfterSelect</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmDelete" name="Подтверждение удаления" camunda:candidateUsers="${initiatorUserId}" camunda:formRef="confirm-delete" camunda:formRefBinding="latest">
      <bpmn:incoming>F_CheckOk_b</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_InitContext" name="Инициализация контекста" camunda:delegateExpression="${initUserContextDelegate}">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckOwnerAvailableListings" name="Проверка доступных объявлений" camunda:delegateExpression="${checkOwnerAvailableListingsDelegate}">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F1_CheckAvailable</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_HasAvailableListings" name="Есть доступные?" default="F_NoAvailableListings">
      <bpmn:incoming>F1_CheckAvailable</bpmn:incoming>
      <bpmn:outgoing>F_HasAvailableListings</bpmn:outgoing>
      <bpmn:outgoing>F_NoAvailableListings</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_ListingIdProvided" name="ID задан?" default="F_AskListing">
      <bpmn:incoming>F_HasAvailableListings</bpmn:incoming>
      <bpmn:outgoing>F_ListingIdProvided</bpmn:outgoing>
      <bpmn:outgoing>F_AskListing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PrepareListingForm_Select" name="Подготовка формы (выбор)" camunda:delegateExpression="${prepareListingFormDelegate}">
      <bpmn:incoming>F_AskListing</bpmn:incoming>
      <bpmn:outgoing>F_AskListing_b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckOwnership" name="Проверка владельца" camunda:delegateExpression="${checkListingOwnershipDelegate}">
      <bpmn:incoming>F_ListingIdProvided</bpmn:incoming>
      <bpmn:incoming>F2_AfterSelect</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_CheckResult" name="Проверка пройдена?" default="F_CheckOk">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_CheckOk</bpmn:outgoing>
      <bpmn:outgoing>F_NotFound</bpmn:outgoing>
      <bpmn:outgoing>F_NotOwner</bpmn:outgoing>
      <bpmn:outgoing>F_NotAvailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PrepareListingForm_Confirm" name="Подготовка формы (подтверждение)" camunda:delegateExpression="${prepareListingFormDelegate}">
      <bpmn:incoming>F_CheckOk</bpmn:incoming>
      <bpmn:outgoing>F_CheckOk_b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_ConfirmDecision" name="Подтверждено?" default="F_Cancel">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Confirmed</bpmn:outgoing>
      <bpmn:outgoing>F_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DeleteListing" name="Мягкое удаление" camunda:delegateExpression="${deleteListingDelegate}">
      <bpmn:incoming>F_Confirmed</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_DeleteResult" name="Удаление успешно?" default="F_DeleteOk">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F_DeleteOk</bpmn:outgoing>
      <bpmn:outgoing>F_DeleteFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Deleted" name="Удалено">
      <bpmn:incoming>F_DeleteOk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PrepareBusinessError" name="Подготовка уведомления об ошибке" camunda:delegateExpression="${prepareBusinessErrorNotificationDelegate}">
      <bpmn:incoming>F_NoAvailableListings</bpmn:incoming>
      <bpmn:incoming>F_NotFound</bpmn:incoming>
      <bpmn:incoming>F_NotOwner</bpmn:incoming>
      <bpmn:incoming>F_NotAvailable</bpmn:incoming>
      <bpmn:incoming>F_DeleteFail</bpmn:incoming>
      <bpmn:outgoing>F_BusinessErrorPrepared</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendBusinessError" name="Отправка уведомления об ошибке" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F_BusinessErrorPrepared</bpmn:incoming>
      <bpmn:outgoing>F_BusinessErrorSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Delete_BusinessError" name="Ошибка данных">
      <bpmn:incoming>F_BusinessErrorSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_AskListing_b" sourceRef="Task_PrepareListingForm_Select" targetRef="Task_SelectListing" />
    <bpmn:sequenceFlow id="F2_AfterSelect" sourceRef="Task_SelectListing" targetRef="Task_CheckOwnership" />
    <bpmn:sequenceFlow id="F_CheckOk_b" sourceRef="Task_PrepareListingForm_Confirm" targetRef="Task_ConfirmDelete" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_ConfirmDelete" targetRef="Gw_ConfirmDecision" />
    <bpmn:sequenceFlow id="F_Confirmed" name="Подтверждено" sourceRef="Gw_ConfirmDecision" targetRef="Task_DeleteListing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${confirmDelete == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Cancel" name="Отказано" sourceRef="Gw_ConfirmDecision" targetRef="Task_PrepareCancelledNotify" />
    <bpmn:sequenceFlow id="F0" sourceRef="Start_Delete" targetRef="Task_InitContext" />
    <bpmn:sequenceFlow id="F1" sourceRef="Task_InitContext" targetRef="Task_CheckOwnerAvailableListings" />
    <bpmn:sequenceFlow id="F1_CheckAvailable" sourceRef="Task_CheckOwnerAvailableListings" targetRef="Gw_HasAvailableListings" />
    <bpmn:sequenceFlow id="F_HasAvailableListings" name="Да" sourceRef="Gw_HasAvailableListings" targetRef="Gw_ListingIdProvided">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasAvailableListings}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NoAvailableListings" name="Нет" sourceRef="Gw_HasAvailableListings" targetRef="Task_PrepareBusinessError" />
    <bpmn:sequenceFlow id="F_ListingIdProvided" name="Да" sourceRef="Gw_ListingIdProvided" targetRef="Task_CheckOwnership">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('listingId') &amp;&amp; listingId != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_AskListing" name="Нет" sourceRef="Gw_ListingIdProvided" targetRef="Task_PrepareListingForm_Select" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckOwnership" targetRef="Gw_CheckResult" />
    <bpmn:sequenceFlow id="F_NotFound" name="Не найдено" sourceRef="Gw_CheckResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_FOUND'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NotOwner" name="Не владелец" sourceRef="Gw_CheckResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_OWNER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NotAvailable" name="Недоступно" sourceRef="Gw_CheckResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('checkError') &amp;&amp; checkError == 'NOT_AVAILABLE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_CheckOk" name="ОК" sourceRef="Gw_CheckResult" targetRef="Task_PrepareListingForm_Confirm" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_DeleteListing" targetRef="Gw_DeleteResult" />
    <bpmn:sequenceFlow id="F_DeleteFail" name="Ошибка" sourceRef="Gw_DeleteResult" targetRef="Task_PrepareBusinessError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('deleteError') &amp;&amp; deleteError != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_DeleteOk" name="Успех" sourceRef="Gw_DeleteResult" targetRef="End_Deleted" />
    <bpmn:sequenceFlow id="F_BusinessErrorPrepared" sourceRef="Task_PrepareBusinessError" targetRef="Task_SendBusinessError" />
    <bpmn:sequenceFlow id="F_BusinessErrorSent" sourceRef="Task_SendBusinessError" targetRef="End_Delete_BusinessError" />
    <bpmn:sequenceFlow id="F_CancelPrepared" sourceRef="Task_PrepareCancelledNotify" targetRef="Task_SendCancelledNotify" />
    <bpmn:sequenceFlow id="F_CancelSent" sourceRef="Task_SendCancelledNotify" targetRef="End_DeleteCancelled" />
    <bpmn:endEvent id="End_DeleteCancelled" name="Удаление отменено">
      <bpmn:incoming>F_CancelSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PrepareCancelledNotify" name="Подготовка уведомления об отмене" camunda:delegateExpression="${prepareDeleteCancelledNotificationDelegate}">
      <bpmn:incoming>F_Cancel</bpmn:incoming>
      <bpmn:outgoing>F_CancelPrepared</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendCancelledNotify" name="Отправка уведомления об отмене" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>F_CancelPrepared</bpmn:incoming>
      <bpmn:outgoing>F_CancelSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_Delete" name="Старт">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
