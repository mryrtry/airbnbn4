{
  "id": "check-out",
  "schemaVersion": 16,
  "components": [
    {
      "type": "text",
      "label": "Подтверждение выезда",
      "id": "InfoHeader",
      "text": "Подтвердите выезд по бронированию."
    },
    {
      "type": "textfield",
      "label": "Номер брони",
      "id": "InfoBookingId",
      "key": "formBookingId",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Объявление",
      "id": "InfoListingTitle",
      "key": "formListingTitle",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Адрес",
      "id": "InfoListingAddress",
      "key": "formListingAddress",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Даты",
      "id": "InfoDates",
      "key": "formBookingDates",
      "readonly": true
    },
    {
      "type": "checkbox",
      "label": "Подтверждаю выезд",
      "id": "Field_confirm",
      "key": "checkOutConfirm",
      "validate": { "required": true }
    }
  ],
  "type": "default"
}