{
  "id": "edit-listing",
  "schemaVersion": 16,
  "components": [
    {
      "type": "text",
      "label": "Редактирование объявления",
      "id": "InfoHeader",
      "text": "Измените данные объявления."
    },
    {
      "type": "textfield",
      "label": "ID объявления",
      "id": "InfoListingId",
      "key": "formListingId",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Название",
      "id": "Field_title",
      "key": "title",
      "validate": { "required": true, "minLength": 3, "maxLength": 255 }
    },
    {
      "type": "textfield",
      "label": "Адрес",
      "id": "Field_address",
      "key": "address",
      "validate": { "required": true, "minLength": 3, "maxLength": 255 }
    },
    {
      "type": "textarea",
      "label": "Описание",
      "id": "Field_description",
      "key": "description",
      "validate": { "maxLength": 2000 }
    },
    {
      "type": "number",
      "label": "Цена за ночь",
      "id": "Field_price",
      "key": "price",
      "validate": { "required": true, "min": 1, "max": 1000000 }
    }
  ],
  "type": "default"
}