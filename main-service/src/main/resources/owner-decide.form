{
  "id": "owner-decide",
  "schemaVersion": 16,
  "components": [
    {
      "type": "text",
      "label": "Информация о бронировании",
      "id": "InfoHeader",
      "text": "Проверьте данные заявки и примите решение."
    },
    {
      "type": "textfield",
      "label": "Номер брони",
      "id": "InfoBookingId",
      "key": "formBookingId",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Объявление",
      "id": "InfoListingTitle",
      "key": "formListingTitle",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Адрес",
      "id": "InfoListingAddress",
      "key": "formListingAddress",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Гость",
      "id": "InfoGuestId",
      "key": "formGuestId",
      "readonly": true
    },
    {
      "type": "textfield",
      "label": "Даты",
      "id": "InfoDates",
      "key": "formBookingDates",
      "readonly": true
    },
    {
      "type": "select",
      "label": "Решение",
      "id": "Field_decision",
      "key": "ownerDecision",
      "values": [
        { "label": "Одобрить", "value": "APPROVE" },
        { "label": "Отклонить", "value": "REJECT" }
      ],
      "validate": { "required": true }
    },
    {
      "type": "textarea",
      "label": "Комментарий",
      "id": "Field_comment",
      "key": "ownerComment",
      "validate": { "maxLength": 1000 }
    }
  ],
  "type": "default"
}