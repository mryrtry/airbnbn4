{
  "id": "select-listing",
  "schemaVersion": 16,
  "components": [
    {
      "type": "text",
      "label": "Информация",
      "id": "InfoHeader",
      "text": "Выберите объявление."
    },
    {
      "type": "textarea",
      "label": "Доступные объявления",
      "id": "InfoAvailableListings",
      "key": "formAvailableListings",
      "readonly": true,
      "layout": { "row": "Row_Info1", "columns": null }
    },
    {
      "type": "number",
      "label": "ID объявления",
      "id": "Field_listingId",
      "key": "listingId",
      "validate": { "required": true, "min": 1, "max": 999999 }
    }
  ],
  "type": "default"
}