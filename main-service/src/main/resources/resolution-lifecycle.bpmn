<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_ResolutionLifecycle" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collab_Resolution">
    <bpmn:participant id="Participant_Airbnb" name="Airbnb" processRef="resolution-lifecycle" />
  </bpmn:collaboration>
  <bpmn:process id="resolution-lifecycle" name="Резолюции" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Resolution">
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Start_Resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateWindow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyWindowOpened</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyWindowOpened</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareResolutionForm_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyComplaintFiled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyComplaintFiled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareResolutionForm_Admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AdminDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectComplaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyRejectedGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyRejectedGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyRejectedOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyRejectedOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ComplaintRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyApprovedGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyApprovedGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyApprovedOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyApprovedOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareResolutionForm_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_UserDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyPaidGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyPaidGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyPaidOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyPaidOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BanUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyDeclinedGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyDeclinedGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyDeclinedOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyDeclinedOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Banned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseWindowExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNotifyExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotifyExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_WindowExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_WindowExpire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Админ">
        <bpmn:flowNodeRef>Task_AdminReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="Владелец">
        <bpmn:flowNodeRef>Task_OwnerFileComplaint</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guest" name="Гость">
        <bpmn:flowNodeRef>Task_UserPay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Resolution" name="Старт">
      <bpmn:outgoing>R0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreateWindow" name="Создание окна резолюции" camunda:delegateExpression="${createResolutionWindowDelegate}">
      <bpmn:incoming>R0</bpmn:incoming>
      <bpmn:outgoing>R1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyWindowOpened" name="Подготовка уведомления об открытии окна" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_WINDOW_OPENED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R1</bpmn:incoming>
      <bpmn:outgoing>R2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyWindowOpened" name="Отправка уведомления об открытии окна" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R2</bpmn:incoming>
      <bpmn:outgoing>R3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareResolutionForm_File" name="Подготовка формы резолюции (подача)" camunda:delegateExpression="${prepareResolutionFormDelegate}">
      <bpmn:incoming>R3</bpmn:incoming>
      <bpmn:outgoing>R3b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_OwnerFileComplaint" name="Подача жалобы" camunda:candidateUsers="${ownerId}" camunda:formRef="file-complaint" camunda:formRefBinding="latest">
      <bpmn:incoming>R3b</bpmn:incoming>
      <bpmn:outgoing>R4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RegisterComplaint" name="Регистрация жалобы" camunda:delegateExpression="${registerComplaintDelegate}">
      <bpmn:incoming>R4</bpmn:incoming>
      <bpmn:outgoing>R5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyComplaintFiled" name="Подготовка уведомления о подаче жалобы" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_FILED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R5</bpmn:incoming>
      <bpmn:outgoing>R6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyComplaintFiled" name="Отправка уведомления о подаче жалобы" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R6</bpmn:incoming>
      <bpmn:outgoing>R7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareResolutionForm_Admin" name="Подготовка формы резолюции (админ)" camunda:delegateExpression="${prepareResolutionFormDelegate}">
      <bpmn:incoming>R7</bpmn:incoming>
      <bpmn:outgoing>R7b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AdminReview" name="Рассмотрение жалобы" camunda:candidateGroups="ADMIN" camunda:formRef="resolution-decide" camunda:formRefBinding="latest">
      <bpmn:incoming>R7b</bpmn:incoming>
      <bpmn:outgoing>R8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_AdminDecision" name="Решение администратора?" default="R_REJECT">
      <bpmn:incoming>R8</bpmn:incoming>
      <bpmn:outgoing>R_APPROVE</bpmn:outgoing>
      <bpmn:outgoing>R_REJECT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ApproveComplaint" name="Одобрение жалобы" camunda:delegateExpression="${approveComplaintDelegate}">
      <bpmn:incoming>R_APPROVE</bpmn:incoming>
      <bpmn:outgoing>R9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RejectComplaint" name="Отклонение жалобы" camunda:delegateExpression="${rejectComplaintDelegate}">
      <bpmn:incoming>R_REJECT</bpmn:incoming>
      <bpmn:outgoing>R25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyRejectedGuest" name="Подготовка уведомления об отклонении (гость)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_REJECTED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R25</bpmn:incoming>
      <bpmn:outgoing>R26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyRejectedGuest" name="Отправка уведомления об отклонении (гость)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R26</bpmn:incoming>
      <bpmn:outgoing>R27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyRejectedOwner" name="Подготовка уведомления об отклонении (владелец)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_REJECTED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R27</bpmn:incoming>
      <bpmn:outgoing>R28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyRejectedOwner" name="Отправка уведомления об отклонении (владелец)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R28</bpmn:incoming>
      <bpmn:outgoing>R29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ComplaintRejected" name="Жалоба отклонена">
      <bpmn:incoming>R29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PrepareNotifyApprovedGuest" name="Подготовка уведомления об одобрении (гость)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_APPROVED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R9</bpmn:incoming>
      <bpmn:outgoing>R10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyApprovedGuest" name="Отправка уведомления об одобрении (гость)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R10</bpmn:incoming>
      <bpmn:outgoing>R11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyApprovedOwner" name="Подготовка уведомления об одобрении (владелец)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_APPROVED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R11</bpmn:incoming>
      <bpmn:outgoing>R12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyApprovedOwner" name="Отправка уведомления об одобрении (владелец)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R12</bpmn:incoming>
      <bpmn:outgoing>R13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareResolutionForm_Pay" name="Подготовка формы резолюции (оплата)" camunda:delegateExpression="${prepareResolutionFormDelegate}">
      <bpmn:incoming>R13</bpmn:incoming>
      <bpmn:outgoing>R13b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_UserPay" name="Оплата компенсации" camunda:candidateUsers="${guestId}" camunda:formRef="resolution-pay" camunda:formRefBinding="latest">
      <bpmn:incoming>R13b</bpmn:incoming>
      <bpmn:outgoing>R14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_UserDecision" name="Решение гостя?" default="R_DECLINE">
      <bpmn:incoming>R14</bpmn:incoming>
      <bpmn:outgoing>R_PAY</bpmn:outgoing>
      <bpmn:outgoing>R_DECLINE</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RegisterPayment" name="Регистрация платежа" camunda:delegateExpression="${registerPaymentDelegate}">
      <bpmn:incoming>R_PAY</bpmn:incoming>
      <bpmn:outgoing>R15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyPaidGuest" name="Подготовка уведомления об оплате (гость)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_PAID</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R15</bpmn:incoming>
      <bpmn:outgoing>R16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyPaidGuest" name="Отправка уведомления об оплате (гость)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R16</bpmn:incoming>
      <bpmn:outgoing>R17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyPaidOwner" name="Подготовка уведомления об оплате (владелец)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_PAID</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R17</bpmn:incoming>
      <bpmn:outgoing>R18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyPaidOwner" name="Отправка уведомления об оплате (владелец)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R18</bpmn:incoming>
      <bpmn:outgoing>R19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Paid" name="Оплачено">
      <bpmn:incoming>R19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_BanUser" name="Блокировка пользователя" camunda:delegateExpression="${banUserDelegate}">
      <bpmn:incoming>R_DECLINE</bpmn:incoming>
      <bpmn:outgoing>R20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyDeclinedGuest" name="Подготовка уведомления об отказе (гость)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_DECLINED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">GUEST</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R20</bpmn:incoming>
      <bpmn:outgoing>R21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyDeclinedGuest" name="Отправка уведомления об отказе (гость)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R21</bpmn:incoming>
      <bpmn:outgoing>R22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyDeclinedOwner" name="Подготовка уведомления об отказе (владелец)" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_DECLINED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R22</bpmn:incoming>
      <bpmn:outgoing>R23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyDeclinedOwner" name="Отправка уведомления об отказе (владелец)" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R23</bpmn:incoming>
      <bpmn:outgoing>R24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Banned" name="Заблокирован">
      <bpmn:incoming>R24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CloseWindowExpired" name="Закрытие окна (истекло)" camunda:delegateExpression="${closeResolutionWindowExpiredDelegate}">
      <bpmn:incoming>R_TIMEOUT</bpmn:incoming>
      <bpmn:outgoing>R_TIMEOUT2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrepareNotifyExpired" name="Подготовка уведомления об истечении" camunda:delegateExpression="${prepareResolutionNotificationDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="notificationType">RESOLUTION_WINDOW_EXPIRED</camunda:inputParameter>
          <camunda:inputParameter name="notificationRecipient">OWNER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>R_TIMEOUT2</bpmn:incoming>
      <bpmn:outgoing>R_TIMEOUT3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendNotifyExpired" name="Отправка уведомления об истечении" camunda:delegateExpression="${sendNotificationDelegate}">
      <bpmn:incoming>R_TIMEOUT3</bpmn:incoming>
      <bpmn:outgoing>R_TIMEOUT4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_WindowExpired" name="Окно истекло">
      <bpmn:incoming>R_TIMEOUT4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="R0" sourceRef="Start_Resolution" targetRef="Task_CreateWindow" />
    <bpmn:sequenceFlow id="R1" sourceRef="Task_CreateWindow" targetRef="Task_PrepareNotifyWindowOpened" />
    <bpmn:sequenceFlow id="R2" sourceRef="Task_PrepareNotifyWindowOpened" targetRef="Task_SendNotifyWindowOpened" />
    <bpmn:sequenceFlow id="R3" sourceRef="Task_SendNotifyWindowOpened" targetRef="Task_PrepareResolutionForm_File" />
    <bpmn:sequenceFlow id="R3b" sourceRef="Task_PrepareResolutionForm_File" targetRef="Task_OwnerFileComplaint" />
    <bpmn:sequenceFlow id="R4" sourceRef="Task_OwnerFileComplaint" targetRef="Task_RegisterComplaint" />
    <bpmn:sequenceFlow id="R5" sourceRef="Task_RegisterComplaint" targetRef="Task_PrepareNotifyComplaintFiled" />
    <bpmn:sequenceFlow id="R6" sourceRef="Task_PrepareNotifyComplaintFiled" targetRef="Task_SendNotifyComplaintFiled" />
    <bpmn:sequenceFlow id="R7" sourceRef="Task_SendNotifyComplaintFiled" targetRef="Task_PrepareResolutionForm_Admin" />
    <bpmn:sequenceFlow id="R7b" sourceRef="Task_PrepareResolutionForm_Admin" targetRef="Task_AdminReview" />
    <bpmn:sequenceFlow id="R8" sourceRef="Task_AdminReview" targetRef="Gw_AdminDecision" />
    <bpmn:sequenceFlow id="R_APPROVE" name="Одобрено" sourceRef="Gw_AdminDecision" targetRef="Task_ApproveComplaint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adminDecision == 'APPROVE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R_REJECT" name="Отклонено" sourceRef="Gw_AdminDecision" targetRef="Task_RejectComplaint" />
    <bpmn:sequenceFlow id="R9" sourceRef="Task_ApproveComplaint" targetRef="Task_PrepareNotifyApprovedGuest" />
    <bpmn:sequenceFlow id="R10" sourceRef="Task_PrepareNotifyApprovedGuest" targetRef="Task_SendNotifyApprovedGuest" />
    <bpmn:sequenceFlow id="R11" sourceRef="Task_SendNotifyApprovedGuest" targetRef="Task_PrepareNotifyApprovedOwner" />
    <bpmn:sequenceFlow id="R12" sourceRef="Task_PrepareNotifyApprovedOwner" targetRef="Task_SendNotifyApprovedOwner" />
    <bpmn:sequenceFlow id="R13" sourceRef="Task_SendNotifyApprovedOwner" targetRef="Task_PrepareResolutionForm_Pay" />
    <bpmn:sequenceFlow id="R13b" sourceRef="Task_PrepareResolutionForm_Pay" targetRef="Task_UserPay" />
    <bpmn:sequenceFlow id="R14" sourceRef="Task_UserPay" targetRef="Gw_UserDecision" />
    <bpmn:sequenceFlow id="R_PAY" name="Оплата" sourceRef="Gw_UserDecision" targetRef="Task_RegisterPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${userDecision == 'PAY'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R_DECLINE" name="Отказ" sourceRef="Gw_UserDecision" targetRef="Task_BanUser" />
    <bpmn:sequenceFlow id="R15" sourceRef="Task_RegisterPayment" targetRef="Task_PrepareNotifyPaidGuest" />
    <bpmn:sequenceFlow id="R16" sourceRef="Task_PrepareNotifyPaidGuest" targetRef="Task_SendNotifyPaidGuest" />
